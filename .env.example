# Copy this file to .env.local and adjust values for your environment.

# REST API base URL used by lib/api/client.ts
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# SockJS/STOMP endpoint used by hooks/useWebSocket.ts.
# Keep this same-origin in local development so Next can proxy /ws to the backend.
NEXT_PUBLIC_WS_URL=/ws

# Server-side proxy target used by next.config.ts for /ws.
API_PROXY_TARGET=http://localhost:8080
